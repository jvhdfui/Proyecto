<%- include("templates/encabezado.ejs", {titulo:"Mis Favoritos"}) %>
<style>
    body {
        font-family: 'Open Sans', sans-serif;
        background-size: cover;
        background-repeat: no-repeat;
        background-image: url("/fondo3.jpeg");
    }

    .receta-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #e0e0e0;
        height: 100%;
        background: #FFD1D1;  
    }
    
    .receta-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
    }
    
    .receta-imagen {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #F94F94;
    }
    
    .receta-imagen img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .categoria {
        background: #f0e6ff;
        color: #7F669D;
        padding: 6px 15px;
        border-radius: 15px;
        font-size: 0.85rem;
        font-weight: bold;
    }
    
    .btn-ver-mas {
        background: #B95E82;
        color: white;
        border: none;
    }
    
    .btn-ver-mas:hover {
        background: #6a5585;
        color: white;
    }

    .calificacion {
        color: #ffc107;
        font-size: 14px;
        margin: 5px 0;
        font-weight: bold;
    }

    .sin-recetas {
        padding: 60px 20px;
        text-align: center;
        background: rgba(255,255,255,0.9);
        border-radius: 15px;
        margin: 20px 0;
    }
</style>

<div class="container my-5">
    <h1 class="text-center mb-4" style="color: #D94392;"> Mis Recetas Favoritas</h1>
    
    <% if (recetas && recetas.length > 0) { %>
        <div class="row g-4">
            <% recetas.forEach(receta => { %>
                <div class="col-md-6 col-lg-3">
                    <div class="card receta-card h-100">
                        <div class="receta-imagen">
                            <% if (receta.foto) { %>
                                <img src="/images/<%= receta.foto %>" alt="<%= receta.nombre %>" class="img-fluid">
                            <% } else { %>
                                <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                    <i class="fas fa-utensils fa-2x text-muted"></i>
                                </div>
                            <% } %>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title"><%= receta.nombre %></h5>
                            <p class="card-text flex-grow-1"><%= receta.descripcion || 'Una deliciosa receta para disfrutar' %></p>
                            
                            <!-- Calificación -->
                            <% if (receta.promedioCalificacion && receta.promedioCalificacion > 0) { %>
                                <div class="calificacion mb-2">
                                    <% 
                                    let estrellas = '';
                                    for(let i = 1; i <= 5; i++) {
                                        if (i <= Math.round(receta.promedioCalificacion)) {
                                            estrellas += '★';
                                        } else {
                                            estrellas += '☆';
                                        }
                                    }
                                    %>
                                    <%= estrellas %> (<%= receta.promedioCalificacion.toFixed(1) %>)
                                </div>
                            <% } %>
                            
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="categoria"><%= receta.categoria %></span>
                                <a href="/receta/<%= receta._id %>" class="btn btn-ver-mas btn-sm">Ver Receta</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="sin-recetas">
            <i class="fas fa-heart fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No tienes recetas favoritas</h4>
            <p class="text-muted">Agrega recetas a tus favoritos para verlas aquí</p>
            <a href="/mostrarRecetas" class="btn btn-primary">Explorar Recetas</a>
        </div>
    <% } %>
</div>

<%- include("templates/pie.ejs") %>