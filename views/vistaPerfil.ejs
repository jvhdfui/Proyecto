<%- include("templates/encabezado.ejs", { titulo: "Mi Perfil" }) %>

<div style="text-align:center; margin-top:40px;">
  <h1 style="color:#d63384;">Mi Perfil</h1>
</div>

<div style="
  width: 420px;
  margin: 40px auto;
  background: #ffc4d0;
  padding: 30px;
  border-radius: 20px;
  box-shadow: 0px 0px 18px rgba(0,0,0,0.2);
">

<div style="text-align:center;">

  <!-- FOTO MOSTRADA -->
  <img id="preview" 
       src="<%= user.foto ? '/uploads/' + user.foto : '/img/default.png' %>" 
       width="150" height="150"
       style="border-radius:100px; cursor:pointer; border:4px solid white;">

</div>

<form action="/perfil/editar" method="POST" enctype="multipart/form-data">

  <!-- INPUT DE FOTO OCULTO -->
  <input id="fileFoto" type="file" name="foto" accept="image/*" style="display:none;">

  <input type="text" name="username" class="input" value="<%= user.username %>" placeholder="Usuario">
  <input type="number" name="edad" class="input" value="<%=user.edad%>" placeholder="Edad">
  <input type="email" name="email" class="input" value="<%= user.email %>" placeholder="Correo">
  <input type="text" name="telefono" class="input" value="<%= user.telefono %>" placeholder="Teléfono">
  <input type="password" name="password" class="input" placeholder="Nueva contraseña">

  <button class="btn">Guardar cambios</button>
</form>

<form action="/perfil/eliminar" method="POST" style="margin-top:20px;">
  <button class="btn-del">Eliminar mi cuenta</button>
</form> 

</div>

<style>
.input {
  width: 100%;
  padding: 12px;
  margin-top: 10px;
  border-radius: 10px;
  border: none;
}

.btn {
  width: 100%;
  padding: 12px;
  background: #6f42c1;
  color: white;
  border: none;
  border-radius: 10px;
  margin-top: 15px;
}

.btn-del {
  width: 100%;
  padding: 12px;
  background: #dc3545;
  color: white;
  border: none;
  border-radius: 10px;
}
</style>

<script>
// Al hacer clic en la imagen → abrir selector de archivo
document.getElementById("preview").onclick = function () {
    document.getElementById("fileFoto").click();
};

// Mostrar foto seleccionada al instante (vista previa)
document.getElementById("fileFoto").onchange = function (e) {
    const file = e.target.files[0];
    if (file) {
        document.getElementById("preview").src = URL.createObjectURL(file);
    }
};
</script>
